# kimi-k3-vllm:v4 -- ONE image, all patches baked, nothing applied at runtime.
#
# Replaces the runtime patch path entirely:
#   - no [k3-overlay] apply at launch
#   - no [pr-stack] per-file apply at launch
#   - no C1-vs-C52 overlay split; ONE overlay for every concurrency
#
# The overlay chosen is the c16_c52 cut, because that is the one behind every
# throughput number in the ledger including the 10,632 peak. Folding C1 onto it
# is a real numerics change for C1 (the c1 cut carried an online-quantization /
# weight-loading subsystem this one does not), so C1 must re-pass GSM8K on this
# image before any C1 result from it is trusted.
#
# Build (from the agentic/ directory, NOT from k3_patches/):
#   docker build -f k3_patches/Dockerfile.kimi-k3-vllm.v4 -t kimi-k3-vllm:v4 .
#
# DO NOT push to Docker Hub. Local tag only.

ARG BASE_IMAGE=vllm/vllm-openai-rocm:nightly-46638857fdbb30e0c232c9e8f9cb1ff6d6f545c3@sha256:8908b8ab5ba28c3b81f9f42bb72e2421f06a180e001c67c4f10ff7f127c5690b
FROM ${BASE_IMAGE}

ARG SITE=/usr/local/lib/python3.12/dist-packages
ARG K3_OVERLAY_SHA256=90f975fad15722494366153ec3f32a14c4445bfa88c51ec53043b88eaf64dcc0

COPY k3_patches/vllm_nightly_46638857_k3_c16_c52_current.patch /tmp/k3.patch
COPY k3_patches/pr_stack/ /tmp/pr_stack/

# Layer 1 (overlay) is FATAL if it fails -- a silently unpatched image would
# produce a misleading number. Layer 2 (pr-stack) is applied per-file for the
# same reason it is at runtime: patch(1) is all-or-nothing per invocation, so
# one stale hunk would otherwise veto every file. Unlike the runtime path this
# build treats a pr-stack failure as fatal too: an image is a durable artifact
# and must not ship in a half-applied state.
RUN set -eux; \
    echo "${K3_OVERLAY_SHA256}  /tmp/k3.patch" | sha256sum -c -; \
    cd "${SITE}"; \
    patch -p1 --forward --batch < /tmp/k3.patch; \
    for p in /tmp/pr_stack/*.patch; do \
        echo "[build] pr-stack: $(basename "$p")"; \
        patch -p1 --forward --batch < "$p"; \
    done; \
    rm -rf /tmp/k3.patch /tmp/pr_stack

# Marker the launcher checks to skip all runtime patching. Its presence is the
# contract: if this file exists, the image is fully patched and the script must
# not touch site-packages.
RUN printf '%s\n' \
    'k3-image: kimi-k3-vllm:v4' \
    'base: vllm/vllm-openai-rocm:nightly-46638857fdbb30e0c232c9e8f9cb1ff6d6f545c3' \
    'base-digest: sha256:8908b8ab5ba28c3b81f9f42bb72e2421f06a180e001c67c4f10ff7f127c5690b' \
    'overlay: vllm_nightly_46638857_k3_c16_c52_current.patch (all concurrencies)' \
    'overlay-sha256: 90f975fad15722494366153ec3f32a14c4445bfa88c51ec53043b88eaf64dcc0' \
    'pr-stack: 5 files (#53940 a4w4-flydsl, #50813 SiTUv2-A8W4-MoE)' \
    'runtime-patching: none' \
    > /etc/k3-image-manifest

LABEL org.opencontainers.image.base.digest="sha256:8908b8ab5ba28c3b81f9f42bb72e2421f06a180e001c67c4f10ff7f127c5690b"
LABEL k3.overlay="c16_c52-all-conc"
LABEL k3.pr-stack="53940,50813"
LABEL k3.runtime-patching="none"
