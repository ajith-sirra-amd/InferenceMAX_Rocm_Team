# kimi-k3-vllm:pronly -- the FULLY MERGEABLE stack. No Hyukjoon overlay.
#
# Purpose: measure what a stack made only of upstream PRs delivers, so the
# cost of dropping the 264 KB unpublished overlay is a number rather than a
# guess. This is the goal-B artifact from REPRODUCE.md.
#
# Base is the NEWEST nightly, not 46638857. That matters: the overlay is cut
# against 46638857 and applies nowhere else, but the open PRs are cut against
# recent main and mostly FAIL on 46638857. Testing PR applicability against the
# v4 base was the wrong experiment -- against 7c5dc571 the picture inverts.
#
# What this image carries (12 of the 18 PRs in the ledger):
#
#   already IN the base (merged, ancestry-verified ahead of 7c5dc571):
#     #51705  causal multi-token verification under DCP
#     #53598  per-group DCP cache geometry / prefix-cache hits
#     #52707  clamp negative external block allocation
#     #52033  ROCm dual-stream shared-expert
#
#   applied here, in this order (order is load-bearing, see below):
#     #53917  SimpleCPUOffloadConnector under DCP        (we run offload dram)
#     #51392  online quantization on pre-quantized ckpt
#     #54254  fused KDA gated RMSNorm + per-token FP8    (STACKED on #54248 --
#             its diff already contains #54248, so applying #54248 separately
#             double-applies and fails. Apply #54254 alone.)
#     #52494  fuse MLA q/kv RMSNorm
#     #52968  attn_res + sigmoid_mul + conv fusions
#     #50618  densify strided activations for wvSplitKQ  (python hunk only;
#             the csrc/*.cu hunks cannot apply to a prebuilt image)
#     #54165  mamba align cache under spec decode + KV connector
#
#   plus the separate 4-file pr-stack:
#     #53940  a4w4 flydsl MoE kernels
#
# What is MISSING vs the overlay -- these five conflict with 7c5dc571 itself,
# not with each other (each fails standalone against the pristine base):
#     #53166  MLA prefill chunked-context gather fusion   (1 of 8 hunks)
#     #51437  latent-MoE all-reduce overlap               (1 of 6 hunks)
#     #53301  graph-stable attn metadata reuse            (2 hunks)
#     #52190  torch.compile enablement                    (1 of 1 hunk)
#     #54163  DFlash/DSpark prefix-cache block drop       (1 of 1 hunk)
#
# Two of those (#53166, #51437) are the highest-perf items in the whole set, so
# expect this image to be SLOWER than v4. Quantifying that gap is the point.
#
# #54165 is closed-unmerged upstream; #54163 is the open successor but does not
# apply here. So this stack is "mergeable" with one asterisk, recorded honestly.
#
# Build (from the agentic/ directory, NOT from k3_patches/):
#   docker build -f k3_patches/Dockerfile.kimi-k3-vllm.pronly -t kimi-k3-vllm:pronly .
#
# DO NOT push to Docker Hub. Local tag only.

ARG BASE_IMAGE=vllm/vllm-openai-rocm:nightly-7c5dc571cbd1064ecc8a9b1045637ff647aa22cb
FROM ${BASE_IMAGE}

ARG SITE=/usr/local/lib/python3.12/dist-packages

COPY k3_patches/pr_only/ /tmp/pr_only/
COPY k3_patches/pr_stack/ /tmp/pr_stack/

# Every layer is FATAL on failure. An image is a durable artifact and must not
# ship half-applied -- a silently-unpatched run would produce a misleading
# number, which is exactly the failure mode /etc/k3-image-manifest exists to
# prevent. Numeric filename prefixes fix the apply order.
RUN set -eux; \
    cd "${SITE}"; \
    for p in /tmp/pr_only/*.patch; do \
        echo "[build] pr-only: $(basename "$p")"; \
        patch -p1 --forward --batch < "$p"; \
    done; \
    for p in /tmp/pr_stack/*.patch; do \
        echo "[build] pr-stack: $(basename "$p")"; \
        patch -p1 --forward --batch < "$p"; \
    done; \
    rm -rf /tmp/pr_only /tmp/pr_stack

# Import gate. Catches a patch that applied cleanly but left the tree broken --
# the T224/T225/T226 failure mode, where patch-independence did not imply
# import-independence.
RUN python3 -c "import vllm, vllm.models.kimi_k3.amd.mla, vllm.v1.simple_kv_offload.manager; print('[build] import gate OK')"

RUN printf '%s\n' \
    'k3-image: kimi-k3-vllm:pronly' \
    'base: vllm/vllm-openai-rocm:nightly-7c5dc571cbd1064ecc8a9b1045637ff647aa22cb' \
    'overlay: NONE -- fully-mergeable PR stack only' \
    'pr-in-base: 51705 53598 52707 52033 (merged upstream)' \
    'pr-applied: 53917 51392 54254 52494 52968 50618 54165' \
    'pr-stack: 4 files (#53940 a4w4-flydsl)' \
    'pr-missing-vs-overlay: 53166 51437 53301 52190 54163' \
    'runtime-patching: none' \
    > /etc/k3-image-manifest

LABEL k3.overlay="none"
LABEL k3.pr-applied="53917,51392,54254,52494,52968,50618,54165"
LABEL k3.pr-stack="53940"
LABEL k3.runtime-patching="none"
