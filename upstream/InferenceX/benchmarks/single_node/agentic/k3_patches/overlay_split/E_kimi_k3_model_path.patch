+@triton.jit
+def _store_conv_cache_checkpoint_kernel(
+    x,
+    conv_state,
+    query_start_loc,
+    checkpoint_offsets,
+    checkpoint_state_indices,
+    x_stride_0: tl.constexpr,
+    x_stride_1: tl.constexpr,
+    state_stride_0: tl.constexpr,
+    state_stride_1: tl.constexpr,
+    state_stride_2: tl.constexpr,
+    STATE_LEN: tl.constexpr,
+    WIDTH: tl.constexpr,
+    NULL_STATE_IDX: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    seq_idx = tl.program_id(0)
+    cols = tl.program_id(1) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    state_idx = tl.load(checkpoint_state_indices + seq_idx)
+    checkpoint_offset = tl.load(checkpoint_offsets + seq_idx)
+    valid = (
+        (state_idx != NULL_STATE_IDX)
+        & (checkpoint_offset >= STATE_LEN)
+        & (cols < WIDTH * STATE_LEN)
+    )
+    safe_state_idx = tl.where(state_idx == NULL_STATE_IDX, 0, state_idx)
+    width_idx = cols // STATE_LEN
+    history_idx = cols % STATE_LEN
+    checkpoint_end = tl.load(query_start_loc + seq_idx) + checkpoint_offset
+    token_idx = checkpoint_end - STATE_LEN + history_idx
+    values = tl.load(
+        x + token_idx * x_stride_0 + width_idx * x_stride_1,
+        mask=valid,
+    )
+    tl.store(
+        conv_state
+        + safe_state_idx * state_stride_0
+        + width_idx * state_stride_1
+        + history_idx * state_stride_2,
+        values,
+        mask=valid,
+    )
