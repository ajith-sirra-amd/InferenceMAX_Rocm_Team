# kimi-k3-vllm:v2 -- the stack validated by T190 (9,482 tok/s/GPU @ C60) and
# T192 (GSM8K exact_match 0.995 +/- 0.005, limit 200, 5-shot).
#
# Contents:
#   base    vllm/vllm-openai-rocm:nightly-46638857fdbb30e0c232c9e8f9cb1ff6d6f545c3
#   + K3 overlay  vllm_nightly_46638857_k3_c16_c52_current.patch  (264 KB)
#   + PR #53940   a4w4 flydsl kernels for Kimi-K3 (4 files)
#
# DELIBERATELY EXCLUDED:
#   #50813 SiTUv2 A8W4 MoE -- added after T192, changes MoE quant math, NOT yet
#          validated by GSM8K. Do not fold it in until it has its own eval.
#   #54095 aiter per-stream -- never applied on this base (hunk 2 fails).
ARG BASE_IMAGE=vllm/vllm-openai-rocm:nightly-46638857fdbb30e0c232c9e8f9cb1ff6d6f545c3
FROM ${BASE_IMAGE}

COPY vllm_nightly_46638857_k3_c16_c52_current.patch /tmp/k3.patch
COPY pr_stack/vllm___aiter_ops.py.patch /tmp/pr/
COPY pr_stack/vllm__envs.py.patch /tmp/pr/
COPY pr_stack/vllm__model_executor__layers__fused_moe__experts__rocm_aiter_moe.py.patch /tmp/pr/
COPY pr_stack/vllm__model_executor__layers__fused_moe__oracle__mxfp4.py.patch /tmp/pr/

RUN set -eux; \
    cd /usr/local/lib/python3.12/dist-packages; \
    patch -p1 --forward --batch < /tmp/k3.patch; \
    for p in /tmp/pr/*.patch; do patch -p1 --forward --batch < "$p"; done; \
    rm -rf /tmp/k3.patch /tmp/pr; \
    python3 -c 'import vllm; print("vllm", vllm.__version__)'

LABEL k3.base="nightly-46638857fdbb30e0c232c9e8f9cb1ff6d6f545c3" \
      k3.overlay="vllm_nightly_46638857_k3_c16_c52_current.patch" \
      k3.prs="53940" \
      k3.validated="T190 9482 tok/s/GPU C60; T192 GSM8K 0.995"
