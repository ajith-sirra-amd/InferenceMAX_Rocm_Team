+            gpu_pool.touch([gpu_pool.blocks[block_id] for block_id in request_gpu_ids])
+            self._in_flight_store_gpu_blocks.update(request_gpu_ids)
+            self._in_flight_store_hashes.update(request_hashes)
+            gpu_ids.extend(request_gpu_ids)
+            cpu_ids.extend(block.block_id for block in cpu_blocks)
+            req_ids.append(req_id)
+
+        return gpu_ids, cpu_ids, req_ids
 
