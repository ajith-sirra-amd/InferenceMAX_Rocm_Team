+                break
+
+            if not missing or len(missing) > cpu_pool.get_num_free_blocks():
+                continue
+
+            cpu_blocks = cpu_pool.get_new_blocks(len(missing))
+            request_gpu_ids = [gpu_block_id for gpu_block_id, _, _ in missing]
+            request_hashes = [key for _, key, _ in missing]
+            hash_boundaries = [valid_end for _, _, valid_end in missing]
+            for cpu_block, key, valid_end in zip(
+                cpu_blocks, request_hashes, hash_boundaries, strict=True
+            ):
