+            block_ids_by_group = self._request_block_ids.get(req_id)
+            if request is None or block_ids_by_group is None or not entries:
+                continue
+            boundaries = {boundary for _, _, boundary in entries}
+            assert len(boundaries) == 1
+            boundary = boundaries.pop()
+            assert boundary > 0 and boundary % self.hash_block_size == 0
+            assert boundary <= request.num_prompt_tokens
+            handoff_blocks = {
+                group_id: gpu_block_id for group_id, gpu_block_id, _ in entries
+            }
+            assert len(handoff_blocks) == len(entries)
+            assert max(handoff_blocks) < len(block_ids_by_group)
+
+            missing: list[tuple[int, BlockHashWithGroupId, int]] = []
+            normal_store_boundary = boundary // self.block_size * self.block_size
+            for group_id, (manager, group) in enumerate(
