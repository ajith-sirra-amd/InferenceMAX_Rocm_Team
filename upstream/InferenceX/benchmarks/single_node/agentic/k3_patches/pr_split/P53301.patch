 class KimiK3ROCmKDAMetadataBuilder(GDNAttentionMetadataBuilder):
+    def build(  # type: ignore[override]
+        self,
+        common_prefix_len: int,
+        common_attn_metadata: CommonAttentionMetadata,
+        num_accepted_tokens: torch.Tensor | None = None,
+        num_decode_draft_tokens_cpu: torch.Tensor | None = None,
+        fast_build: bool = False,
+    ) -> KimiK3ROCmKDAMetadata:
+        metadata = super().build(
+            common_prefix_len,
+            common_attn_metadata,
+            num_accepted_tokens,
+            num_decode_draft_tokens_cpu,
+            fast_build,
+        )
+        checkpoint = self._build_checkpoint_metadata(
+            common_attn_metadata,
+            metadata,
+            num_decode_draft_tokens_cpu,
+        )
+        values = {
+            field.name: getattr(metadata, field.name)
+            for field in fields(GDNAttentionMetadata)
+        }
+        return KimiK3ROCmKDAMetadata(**values, checkpoint=checkpoint)
+
+    def _build_checkpoint_metadata(
+        self,
+        m: CommonAttentionMetadata,
+        metadata: GDNAttentionMetadata,
+        num_decode_draft_tokens_cpu: torch.Tensor | None,
+    ) -> KDACheckpointMetadata | None:
+        checkpoint_enabled = is_mamba_prefill_checkpoint_enabled(
+            self.vllm_config.cache_config.mamba_cache_mode,
+            self.kv_cache_spec.num_prefill_checkpoint_blocks,
+        )
+        if metadata.num_prefills == 0 or not checkpoint_enabled:
+            return None
+
+        assert m.seq_lens_cpu_upper_bound is not None
+        query_lens_cpu = m.query_start_loc_cpu.diff()
+        active_spec_mask = None
+        if num_decode_draft_tokens_cpu is not None:
+            candidate_mask = num_decode_draft_tokens_cpu >= 0
+            if candidate_mask.any().item() and (
+                num_decode_draft_tokens_cpu[candidate_mask].sum().item() > 0
+            ):
+                active_spec_mask = candidate_mask
+
+        if active_spec_mask is None:
+            request_rows = list(range(metadata.num_decodes, m.num_reqs))
+        else:
+            request_rows = (
+                ((~active_spec_mask) & (query_lens_cpu > 0))
+                .nonzero(as_tuple=True)[0]
+                .tolist()
+            )
+
+        query_lens = [int(query_lens_cpu[row]) for row in request_rows]
+        seq_lens = m.seq_lens_cpu_upper_bound.tolist()
+        block_size = self.kv_cache_spec.block_size
+        hash_block_size = self.vllm_config.cache_config.prefix_match_unit or block_size
+        checkpoint_alignment = min(hash_block_size, block_size)
+        drop_eagle_block = (
+            self.speculative_config is not None
+            and self.speculative_config.use_eagle_preserves_target_kv_cache()
+        )
+
+        checkpoint_offsets = []
+        checkpoint_cols = []
+        for row, query_len in zip(request_rows, query_lens):
+            seq_len = seq_lens[row]
+            query_start = seq_len - query_len
+            checkpoint_position = get_mamba_prefill_checkpoint_position(
+                seq_len,
+                hash_block_size,
+                drop_eagle_block=drop_eagle_block,
+            )
+            offset = checkpoint_position - query_start
+            valid = (
+                seq_len % block_size != 0
+                and query_start % checkpoint_alignment == 0
+                and query_start + checkpoint_alignment <= checkpoint_position
+                and 0 < offset < query_len
+                and offset % FLA_CHUNK_SIZE == 0
+            )
+            checkpoint_offsets.append(offset if valid else 0)
+            checkpoint_cols.append(seq_len // block_size - 1 if valid else -1)
+
+        if not any(checkpoint_offsets):
+            return None
+
+        device = m.query_start_loc.device
+        offsets_tensor = async_tensor_h2d(
+            checkpoint_offsets,
+            dtype=torch.int32,
+            device=device,
+        )
+        rows_tensor = async_tensor_h2d(
+            request_rows,
+            dtype=torch.int64,
+            device=device,
+        )
+        cols_tensor = async_tensor_h2d(
+            checkpoint_cols,
+            dtype=torch.int64,
+            device=device,
+        )
+        state_indices = m.block_table_tensor[rows_tensor, cols_tensor]
+        state_indices = torch.where(
+            cols_tensor >= 0,
+            state_indices,
+            NULL_BLOCK_ID,
+        )
+        checkpoint_slices = []
+        token_start = 0
+        chunk_start = 0
+        for query_len, offset in zip(query_lens, checkpoint_offsets):
+            checkpoint_slices.append((token_start, offset, chunk_start))
+            token_start += query_len
+            chunk_start += (query_len + FLA_CHUNK_SIZE - 1) // FLA_CHUNK_SIZE
+        return KDACheckpointMetadata(
+            offsets_tensor,
+            state_indices,
+            tuple(checkpoint_slices),
+        )
