+# kernel for. dcp_heads = num_heads * dcp_world_size is 96 for K3 at TP8/DCP8,
+# which is 16-aligned but *not* one of these, so the cprr path pads up to 128.
+_NATIVE_CPRR_HEADS: Final = (16, 32, 64, 128)
+
