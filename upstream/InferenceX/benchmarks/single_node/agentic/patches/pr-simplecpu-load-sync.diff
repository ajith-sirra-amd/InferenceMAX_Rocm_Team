+    def load_sync(
+        self,
+        src_blocks: list[int],
+        dst_blocks: list[int],
+        event_idx: int,
+        events_list: list[tuple[int, torch.Event]],
+    ) -> None:
+        """Synchronous load: copy on load_stream inline (bypassing the
+        background queue) and make the compute stream wait on it, so this
+        step's forward sees the loaded KV. Used for sync KV loads
+        (SchedulerOutput.has_sync_kv_loads) whose blocks are consumed in the
+        same step -- the async launch_copy() path leaves no ordering between
+        the load_stream copy and the compute-stream read, which races under
+        offload fetch-back bursts. copy_blocks() issues on params.stream_handle
+        (load_stream), matching _copy_loop()."""
+        assert self._load_params is not None and self._load_stream is not None
+        copy_blocks(src_blocks, dst_blocks, self._load_params)
+        event = torch.Event()
+        event.record(self._load_stream)
+        torch.cuda.current_stream().wait_event(event)
+        events_list.append((event_idx, event))
+
