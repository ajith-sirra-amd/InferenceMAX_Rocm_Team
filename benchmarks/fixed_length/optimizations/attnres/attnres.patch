+def _prepare_attn_res_weight_product(norm: RMSNorm, proj: ReplicatedLinear) -> bool:
+    """Prepare immutable score weights after normal model weight loading."""
+    name = "_attnres_input_qk_weight"
+    if name not in proj._buffers:
+        proj.register_buffer(name, None, persistent=False)
+    if not isinstance(proj.quant_method, UnquantizedLinearMethod):
+        setattr(proj, name, None)
+        return False
+    norm_weight, qk_weight = norm.weight, proj.weight
+    if (
+        envs.VLLM_BATCH_INVARIANT
+        or norm_weight.shape != (7168,)
+        or qk_weight.shape != (1, 7168)
+        or norm_weight.dtype != torch.bfloat16
+        or qk_weight.dtype != torch.bfloat16
+        or not norm_weight.is_cuda
+        or norm_weight.device != qk_weight.device
+        or norm_weight.stride(-1) != 1
+        or qk_weight.stride(-1) != 1
+    ):
+        setattr(proj, name, None)
+        return False
+    with torch.no_grad():
+        product = (norm_weight.float() * qk_weight.squeeze(0).float()).contiguous()
+        previous = getattr(proj, name)
+        if (
+            previous is not None
+            and previous.device == product.device
+            and previous.dtype == product.dtype
+            and previous.shape == product.shape
+            and previous.is_contiguous()
+        ):
+            # Keep the buffer address stable when the post-load hook rebuilds it.
+            previous.copy_(product)
+        else:
+            setattr(proj, name, product)
+    return True
+
+
+def _attn_res_product_for_call(
+    prefix: torch.Tensor,
+    blocks: torch.Tensor,
+    proj: ReplicatedLinear,
+    norm: RMSNorm,
+    num_blocks: int,
+    delta: torch.Tensor | None,
+    output_norm: RMSNorm | None,
+    block_write_idx: int,
+    fuse_quant: bool,
+) -> torch.Tensor | None:
+    """Admit only the residual BF16 shapes exercised by the GPU confirmation."""
+    product = getattr(proj, "_attnres_input_qk_weight", None)
+    if (
+        product is None
+        or envs.VLLM_BATCH_INVARIANT
+        or fuse_quant
+        or delta is None
+        or output_norm is None
+        or block_write_idx >= 0
+        or num_blocks not in (4, 8)
+        or prefix.ndim != 2
+        or prefix.shape[0] not in (280, 336)
+        or prefix.shape[1] != 7168
+        or prefix.dtype != torch.bfloat16
+        or delta.dtype != torch.bfloat16
+        or blocks.dtype != torch.bfloat16
+        or norm.weight.dtype != torch.bfloat16
+        or proj.weight.dtype != torch.bfloat16
+        or output_norm.weight.dtype != torch.bfloat16
+        or norm.variance_epsilon != 1e-5
+        or output_norm.variance_epsilon != 1e-5
+        or product.dtype != torch.float32
+        or product.shape != (7168,)
+        or product.device != prefix.device
+        or product.stride(0) != 1
+    ):
+        return None
+    key = (prefix.shape[0], num_blocks)
+    if key not in _ATTNRES_PRODUCT_SEEN:
+        _ATTNRES_PRODUCT_SEEN.add(key)
+        # This is first eligible Python submission, possibly during graph capture.
+        # It is not a count or timing of measured graph replays.
+        logger.info(
+            "ATTNRES_PRODUCT_SELECTED rows=%d blocks=%d dtype=bf16 "
+            "delta=1 output_norm=1 block_write=0 submission=%s", *key,
+            "capture" if torch.cuda.is_current_stream_capturing() else "eager",
+        )
+    return product
 
 
