#!/usr/bin/env bash
# Optional profiling overlay; the native server arguments pass through unchanged.
set -euo pipefail
export PATH="${PATH#/sa-profile-bin:}"
if [[ "${1:-}" != serve ]]; then
    exec vllm "$@"
fi
: "${SA_PROFILE_DELAY_SECONDS:?Calibrate the delay from the successful baseline}"
: "${SA_PROFILE_SECONDS:?Set a bounded capture duration}"
: "${SA_PROFILE_OUTPUT:?Set the profile output directory}"
mkdir -p "$SA_PROFILE_OUTPUT"
date -u +%FT%TZ > "$SA_PROFILE_OUTPUT/launch-utc.txt"
python3 - "$SA_PROFILE_OUTPUT/clock-sync.json" <<'PY'
import json, sys, time
from pathlib import Path
# ROCprofiler SDK timestamps use CLOCK_BOOTTIME; bracket its sample in UTC.
before = time.time_ns()
boot = time.clock_gettime_ns(time.CLOCK_BOOTTIME)
after = time.time_ns()
Path(sys.argv[1]).write_text(json.dumps(dict(utc_before_ns=before,
    boottime_ns=boot, utc_after_ns=after)) + '\n')
PY
if [[ "${SA_PROFILE_MODE:-launch}" == attach ]]; then
    exec python3 "$(dirname "$0")/attach.py" vllm "$@"
fi
# Keep graph correlation without broad HIP API argument serialization at exit.
exec rocprofv3 --kernel-trace --hip-graph-trace --memory-copy-trace --marker-trace --stats \
    --disable-signal-handlers true \
    --collection-period "${SA_PROFILE_DELAY_SECONDS}:${SA_PROFILE_SECONDS}:1" \
    --collection-period-unit sec -f csv json -d "$SA_PROFILE_OUTPUT/traces" \
    -- vllm "$@"
